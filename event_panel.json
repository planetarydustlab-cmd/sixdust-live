      /* 漂浮幅度 */\n  --sd-halo-dur:4.6s;          /* 光暈脈動週期 */\n  --sd-tw-strong:#4ade80; --sd-tw-weak:#f87171;  /* 全站統一 綠=強/漲、紅=弱/跌（2026-07-18） */\n  --sd-us-strong:#4ade80; --sd-us-weak:#f87171;  /* 美股 綠=強（同上，維持不變） */\n  --sd-ember:#ff8a3d;          /* HORIZON / 事件 琥珀 */\n  --sd-neutral:#9aa5b8;\n}\n@keyframes sd-rise{0%{opacity:0;transform:translateY(15px) scale(.9)}62%{opacity:1}100%{opacity:1;transform:translateY(0) scale(1)}}\n@keyframes sd-bob{0%,100%{transform:translateY(calc(var(--sd-bob) * -1))}50%{transform:translateY(var(--sd-bob))}}\n@keyframes sd-halo{0%,100%{box-shadow:0 0 10px 1px var(--_g),0 0 0 0 transparent}50%{box-shadow:0 0 15px 3px var(--_g),0 0 26px 7px var(--_g2,transparent)}}\n/* 行星球體：受光面 highlight + 暗緣 + 光暈 */\n.sd-planet{--_d:32px;--_c:var(--sd-neutral);--_g:rgba(154,165,184,.4);--_g2:rgba(154,165,184,.14);\n  display:inline-block;flex:0 0 auto;width:var(--_d);height:var(--_d);border-radius:50%;\n  background:radial-gradient(circle at 34% 30%,rgba(255,255,255,.6),rgba(255,255,255,0) 42%),\n             radial-gradient(circle at 50% 56%,var(--_c),#0a0d12 84%);\n  box-shadow:0 0 12px 1px var(--_g),inset 0 0 9px -3px #000a;\n  animation:sd-bob var(--sd-bob-dur) ease-in-out infinite,sd-halo var(--sd-halo-dur) ease-in-out infinite}\n.sd-planet.tw-strong{--_c:var(--sd-tw-strong);--_g:rgba(74,222,128,.5);--_g2:rgba(74,222,128,.15)}\n.sd-planet.tw-weak{--_c:var(--sd-tw-weak);--_g:rgba(248,113,113,.5);--_g2:rgba(248,113,113,.15)}\n.sd-planet.us-strong{--_c:var(--sd-us-strong);--_g:rgba(74,222,128,.5);--_g2:rgba(74,222,128,.15)}\n.sd-planet.us-weak{--_c:var(--sd-us-weak);--_g:rgba(248,113,113,.5);--_g2:rgba(248,113,113,.15)}\n.sd-planet.ember{--_c:var(--sd-ember);--_g:rgba(255,138,61,.55);--_g2:rgba(255,138,61,.18)}\n.sd-planet.neutral{--_c:var(--sd-neutral);--_g:rgba(154,165,184,.38)}\n/* 浮力標網格：六（三/二）格行星量表，逐格浮力上升 */\n.sd-buoy-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:1px;\n  background:var(--hair,var(--border,#232a36));border:1px solid var(--hair,var(--border,#232a36));\n  border-radius:3px;overflow:hidden}\n.sd-gauge{position:relative;display:flex;flex-direction:column;align-items:center;gap:9px;\n  padding:17px 12px 15px;background:var(--ink,var(--bg-card,#0e1015));\n  animation:sd-rise var(--sd-rise-dur) var(--sd-rise-ease) both;animation-delay:calc(var(--i,0) * var(--sd-rise-step))}\n.sd-gauge .sd-planet{--_d:30px}\n.sd-g-v{font-family:var(--num,ui-monospace,Menlo,monospace);font-size:18px;font-weight:600;\n  color:#eef2f7;line-height:1;font-variant-numeric:tabular-nums}\n.sd-g-v small{font-size:11px;color:var(--text-3,#6b7385);font-weight:400;margin-left:1px}\n.sd-g-k{font-size:10px;letter-spacing:.08em;color:var(--text-3,#6b7385);display:flex;align-items:center;gap:5px;\n  white-space:nowrap;text-align:center}\n.sd-mkt{font-family:var(--num,ui-monospace,monospace);font-size:8.5px;letter-spacing:.06em;padding:1px 4px;border-radius:2px;font-weight:700}\n.sd-mkt.tw{color:var(--sd-tw-strong);background:rgba(74,222,128,.1)}\n.sd-mkt.us{color:var(--sd-us-strong);background:rgba(74,222,128,.1)}\n/* 浮力晶片（BUOYANCY 面板：行星 + 名稱 + 值）*/\n.sd-chip{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#cdd6e4;\n  background:#10131a;border:1px solid var(--border,#232a36);border-radius:6px;padding:3px 8px 3px 6px}\n.sd-chip .sd-planet{--_d:13px}\n.sd-chip b{font-weight:600;font-variant-numeric:tabular-nums}\n/* 軌道/地平線（HORIZON 前方事件：NOW → 前方航點行星，可橫捲）*/\n.sd-orbit{position:relative;display:flex;align-items:flex-start;gap:0;overflow-x:auto;scrollbar-width:none;\n  padding:16px 2px 4px;margin-top:2px}\n.sd-orbit::-webkit-scrollbar{display:none}\n.sd-orbit::before{content:\"\";position:absolute;left:6px;right:6px;top:23px;height:1px;\n  background:linear-gradient(90deg,var(--sd-ember),rgba(255,138,61,.15) 62%,transparent)}\n.sd-node{flex:0 0 auto;position:relative;display:flex;flex-direction:column;align-items:center;gap:4px;\n  padding:0 11px;min-width:58px;text-decoration:none;\n  animation:sd-rise var(--sd-rise-dur) var(--sd-rise-ease) both;animation-delay:calc(var(--i,0) * var(--sd-rise-step))}\n.sd-node .sd-planet{--_d:13px;margin-bottom:1px}\n.sd-node.sd-now .sd-planet{--_d:9px}\n.sd-node b{font-family:var(--mono,var(--num,ui-monospace,monospace));font-size:11px;color:#cdd6e4;font-variant-numeric:tabular-nums}\n.sd-node .sd-t{font-size:9.5px;line-height:1.35;color:#9aa5b8;max-width:70px;text-align:center}\n.sd-node i{font-style:normal;font-family:var(--mono,var(--num,monospace));font-size:9px;color:#6b7385;letter-spacing:.04em}\n.sd-node.sd-now b{color:var(--sd-ember);letter-spacing:.14em}\n.sd-node.hot b,.sd-node.hot i{color:var(--sd-ember)}\n.sd-node.hot .sd-t{color:#e8edf2}\n.sd-node:hover .sd-t{color:#e8edf2}\n@media(max-width:760px){.sd-buoy-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media(max-width:400px){.sd-buoy-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(prefers-reduced-motion:reduce){.sd-planet,.sd-gauge,.sd-node{animation:none!important}}\n@media print{.sd-planet,.sd-gauge,.sd-node{animation:none!important}}\n</style>\n<div class=\"con-posture\"><div class=\"con-tagcell\">TODAY<span>今日盤勢</span></div><div class=\"con-body\"><div style=\"display:flex;align-items:center;gap:7px 12px;flex-wrap:wrap;margin-bottom:9px\"><span style=\"font-size:11px;color:#6b7385\">2026-10-04 週日 · 週末整理 · 10-03 版判讀 · 今日更新中</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;border:1px solid #3a4150;color:#cdd6e4\">區間整理</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;background:#f871711f;border:1px solid #f8717166;color:#f87171;font-weight:700\">氣壓 -3/6 逆風</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.4);color:#f87171;font-weight:700\">● 事件風險 啟動中</span><a href=\"/home-v3/\" style=\"margin-left:auto;font-size:13px;padding:6px 14px;border-radius:6px;background:#ff8a3d;color:#0f1115;text-decoration:none;font-weight:700\">切換到新版首頁 →</a></div><div style=\"font-size:15px;line-height:1.62;color:#eef2f7;font-weight:500\">美國 9 月非農轉弱、失業率升至 4.2%，市場讀成利率壓力可能鬆動，費半 10/02 大漲 2.4%、台積電 ADR 漲 2.96%，台指夜盤較結算價漲 677 點。但本庫氣壓場仍是逆風 -3，美債與籌碼都沒鬆。週一台積電能否站回 2,510 前收，才算傳導真的接上。</div><div style=\"margin-top:10px;border-top:1px solid #232a36;padding-top:8px\"><div style=\"font-family:ui-monospace,monospace;font-size:9.5px;letter-spacing:.16em;color:#6b7385;margin-bottom:5px\">HISTORY · 過去盤勢（近 20 日判讀 · 可捲動）</div><div style=\"max-height:118px;overflow-y:auto;scrollbar-width:thin;padding-right:6px\"><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">10/02 週五</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半 10/01 大漲 1.59%，台股今天只小漲 0.25%，台積電還收跌 0.4% 至 2,500：美股漲勢沒有傳過來。壓住它的是利率，美債殖利率衝上 24 年高，本庫氣壓場評為逆風 -3。美元指數 101.962 若重新站上 102.21 的 52 週高，代表逆風還沒退。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">10/01 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台股加權指數漲 0.86% 收 48,353，台積電 2,510 領漲。但美股 09/30 費半平盤，台指夜盤小跌 0.07%，這波漲勢是台股自己點火，靠的是記憶體缺貨敘事。外部氣壓仍偏逆風：美元指數 101.645 已貼近 52 週高 101.8，這個關卡破不破，決定漲勢撐不撐得住。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/30 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">美股 09/29 費半漲 1.31%，帶動台指期 10 月合約夜盤收 48,479、較日盤結算價漲 698 點，09/29 聯發科壓出的跌勢有機會先補回。但漲勢只集中在半導體，美元與美債仍是逆風；能不能站穩，要看 09/30 美國 PCE 公布後美元會不會衝破 52 週高。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/29 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台股09/29收跌0.82%至47,631.96，聯發科傳Google TPU訂單生變重挫近7%，壓過台積電傳調漲3奈米報價最高15%的利多；台指夜盤同步走弱至47,956，能否止穩要看09/30美國PCE數據。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/28 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台股休市期間，全球盤面兩頭拉扯：週五費半漲 1.41%，但週一 Brent 反彈至 99.12、黃金跌 2.56%，新聞指向升息預期回溫。台股下個交易日要同時消化晶片利多與油價、利率壓力，09/30 PCE 是放不放行的關鍵。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/27 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">週五油價急退、美股風險偏好回溫：Brent 跌至 97.44，費半漲 1.41%。但台指夜盤收 47,956、跌 169 點，那是美股週五開盤前的價格，還沒反映這波反彈。台股下個交易日能否補上，要看美債 5.18% 與 09/30 PCE 放不放行。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/26 週六</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">昨日胡賽攻擊引爆的油價高台今天急退，Brent 收 97.47（前收 100.22，−2.74%），宏觀氣壓場得分從四力逆風（−4）回到中性（0）。費半同步彈升 1.41% 至 12,669，VIX 跌穿 15 收 14.87，風險偏好顯著解凍；但美債殖利率仍釘在 5.18%、台指夜盤收 47,956（−169 點，vs 前結算 48,125）</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/25 週五</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">胡賽武裝攻擊沙烏地阿拉伯，油價前夜跳漲約 3%，推動三十年期美債殖利率觸二十年高點；Brent 現報 105.38（前收 106.60），雖略自高點回落，長端利率壓力仍壓頂，氣壓場擴至四力逆風（得分 −4）。台股 09/24 日盤收 48,024.60（−132.69 點，−0.28%）</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/24 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">聯準會鷹派加碼將十月升息機率推至近七成，費半 −1.23% 領跌拖累台指夜盤收 47,909（−403 點），氣壓場三力逆風（美元、美債、籌碼）確認短線利率壓力壓過 AI 需求敘事。9/30 PCE 將決定十月升息是否落地。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/23 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪新聞聚焦 AI / 半導體,但當日 tape 上費半 -1.79%明顯走弱;敘事與量價背離時先以量價為錨,別把利多標題放大成趨勢確立。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/22 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半週一飆漲 4.29%、TSM ADR +2.41%，但荷莫茲海峽油輪遇襲將 Brent 推至 97.66 美元，台股日盤僅收漲 0.17%、台積電反跌 0.81%。夜盤 +728 點的樂觀能否兌現，取決於油價守不守得住 100 美元整數關。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/21 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向地緣與能源供給風險；只要油價風險溢價未退場,通膨與利率壓力就不算解除。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/20 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半週五漲 2.78%、加權指數大漲 893 點收 47,181，半導體氣勢壓過一切；但荷莫茲海峽漏油與利雅德機場濃煙在所有市場收盤後才傳出，這筆地緣帳尚未入價。週一驗證：Brent 99.3 是否跳空、台指夜盤 47,405 怎麼接。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/19 週六</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">全球市場主軸是「AI 成長敘事撐住股市」對上「中東 / 油價 / 利率重新推高風險溢價」的拉鋸。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/18 週五</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向地緣與能源供給風險；只要油價風險溢價未退場,通膨與利率壓力就不算解除。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/17 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">全球市場主軸是「AI 成長敘事撐住股市」對上「中東 / 油價 / 利率重新推高風險溢價」的拉鋸。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/16 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">今天的核心分歧：美債 10 年期觸近 4.97%（研究庫標記逆風），FOMC 今晚決議，美股普跌；但費半（SOX +0.40%）與台股加權（+0.68%，盤中 45,820）同步逆勢，聯發科首款 2 奈米手機晶片是本地催化錨點。台指夜盤（9/16 歸屬日，官方收 45,529；基準前收 45,592）夜間整理幅度溫和，日盤快速收復缺口；分叉能否延伸</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/15 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向地緣與能源供給風險；只要油價風險溢價未退場,通膨與利率壓力就不算解除。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/14 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">AI 成長敘事仍在,但當日 tape 上費半 -5.09%明顯走弱、半導體並非最強;再疊加中東 / 油價 / 利率風險溢價,敘事與量價背離時先以量價為錨。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/13 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台股周五急跌 756 點（-1.61%）收 46,185，夜盤期指隨後反彈 401 點。台積電 ADR 同夜漲 1.22%，日盤與夜盤出現清晰分叉。周末沙烏地油管限流加上美軍縮減霍爾木茲護航窗口，兩則地緣訊號尚未計入油價；FOMC 三天後落槌，是本周最近的方向確認節點。</span></div></div></div></div></div><div class=\"con-panels\"><div style=\"background:#12151c;border:1px solid #2a3140;border-radius:12px;padding:11px 12px\"><div style=\"display:flex;align-items:baseline;gap:6px;margin-bottom:9px\"><span style=\"font-size:12.5px;font-weight:700\">資金浮力場</span><span class=\"con-eb\">BUOYANCY</span><a href=\"/sector_strength_tw.html\" style=\"margin-left:auto;font-size:11px;color:#60a5fa;text-decoration:none\">全版 →</a></div><div style=\"display:flex;gap:6px;flex-wrap:wrap;margin-bottom:5px\"><span class=\"sd-chip\"><span class=\"sd-planet tw-strong\" style=\"--_d:13px\"></span>油電燃氣<b style=\"color:#4ade80\">+24</b></span><span class=\"sd-chip\"><span class=\"sd-planet tw-strong\" style=\"--_d:13px\"></span>電子通路<b style=\"color:#4ade80\">+6</b></span></div><div style=\"border-top:1px dashed #2a3140;margin:6px 0;font-size:9px;color:#46506a;text-align:center;line-height:1\">水位線</div><div style=\"display:flex;gap:6px;flex-wrap:wrap;margin-top:5px\"><span class=\"sd-chip\"><span class=\"sd-planet tw-weak\" style=\"--_d:13px\"></span>生技醫療<b style=\"color:#f87171\">-10</b></span><span class=\"sd-chip\"><span class=\"sd-planet tw-weak\" style=\"--_d:13px\"></span>運動休閒<b style=\"color:#f87171\">-8</b></span></div><div style=\"font-size:9.5px;color:#6b7385;margin-top:8px\">綠＝資金流入／紅＝流出 · 球高即浮力 · 更新 10/3 06:30</div></div><div style=\"background:#12151c;border:1px solid #2a3140;border-radius:12px;padding:11px 12px\"><div style=\"display:flex;align-items:baseline;gap:6px;margin-bottom:9px\"><span style=\"font-size:12.5