mes sd-halo{0%,100%{box-shadow:0 0 10px 1px var(--_g),0 0 0 0 transparent}50%{box-shadow:0 0 15px 3px var(--_g),0 0 26px 7px var(--_g2,transparent)}}\n/* 行星球體：受光面 highlight + 暗緣 + 光暈 */\n.sd-planet{--_d:32px;--_c:var(--sd-neutral);--_g:rgba(154,165,184,.4);--_g2:rgba(154,165,184,.14);\n  display:inline-block;flex:0 0 auto;width:var(--_d);height:var(--_d);border-radius:50%;\n  background:radial-gradient(circle at 34% 30%,rgba(255,255,255,.6),rgba(255,255,255,0) 42%),\n             radial-gradient(circle at 50% 56%,var(--_c),#0a0d12 84%);\n  box-shadow:0 0 12px 1px var(--_g),inset 0 0 9px -3px #000a;\n  animation:sd-bob var(--sd-bob-dur) ease-in-out infinite,sd-halo var(--sd-halo-dur) ease-in-out infinite}\n.sd-planet.tw-strong{--_c:var(--sd-tw-strong);--_g:rgba(74,222,128,.5);--_g2:rgba(74,222,128,.15)}\n.sd-planet.tw-weak{--_c:var(--sd-tw-weak);--_g:rgba(248,113,113,.5);--_g2:rgba(248,113,113,.15)}\n.sd-planet.us-strong{--_c:var(--sd-us-strong);--_g:rgba(74,222,128,.5);--_g2:rgba(74,222,128,.15)}\n.sd-planet.us-weak{--_c:var(--sd-us-weak);--_g:rgba(248,113,113,.5);--_g2:rgba(248,113,113,.15)}\n.sd-planet.ember{--_c:var(--sd-ember);--_g:rgba(255,138,61,.55);--_g2:rgba(255,138,61,.18)}\n.sd-planet.neutral{--_c:var(--sd-neutral);--_g:rgba(154,165,184,.38)}\n/* 浮力標網格：六（三/二）格行星量表，逐格浮力上升 */\n.sd-buoy-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:1px;\n  background:var(--hair,var(--border,#232a36));border:1px solid var(--hair,var(--border,#232a36));\n  border-radius:3px;overflow:hidden}\n.sd-gauge{position:relative;display:flex;flex-direction:column;align-items:center;gap:9px;\n  padding:17px 12px 15px;background:var(--ink,var(--bg-card,#0e1015));\n  animation:sd-rise var(--sd-rise-dur) var(--sd-rise-ease) both;animation-delay:calc(var(--i,0) * var(--sd-rise-step))}\n.sd-gauge .sd-planet{--_d:30px}\n.sd-g-v{font-family:var(--num,ui-monospace,Menlo,monospace);font-size:18px;font-weight:600;\n  color:#eef2f7;line-height:1;font-variant-numeric:tabular-nums}\n.sd-g-v small{font-size:11px;color:var(--text-3,#6b7385);font-weight:400;margin-left:1px}\n.sd-g-k{font-size:10px;letter-spacing:.08em;color:var(--text-3,#6b7385);display:flex;align-items:center;gap:5px;\n  white-space:nowrap;text-align:center}\n.sd-mkt{font-family:var(--num,ui-monospace,monospace);font-size:8.5px;letter-spacing:.06em;padding:1px 4px;border-radius:2px;font-weight:700}\n.sd-mkt.tw{color:var(--sd-tw-strong);background:rgba(74,222,128,.1)}\n.sd-mkt.us{color:var(--sd-us-strong);background:rgba(74,222,128,.1)}\n/* 浮力晶片（BUOYANCY 面板：行星 + 名稱 + 值）*/\n.sd-chip{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#cdd6e4;\n  background:#10131a;border:1px solid var(--border,#232a36);border-radius:6px;padding:3px 8px 3px 6px}\n.sd-chip .sd-planet{--_d:13px}\n.sd-chip b{font-weight:600;font-variant-numeric:tabular-nums}\n/* 軌道/地平線（HORIZON 前方事件：NOW → 前方航點行星，可橫捲）*/\n.sd-orbit{position:relative;display:flex;align-items:flex-start;gap:0;overflow-x:auto;scrollbar-width:none;\n  padding:16px 2px 4px;margin-top:2px}\n.sd-orbit::-webkit-scrollbar{display:none}\n.sd-orbit::before{content:\"\";position:absolute;left:6px;right:6px;top:23px;height:1px;\n  background:linear-gradient(90deg,var(--sd-ember),rgba(255,138,61,.15) 62%,transparent)}\n.sd-node{flex:0 0 auto;position:relative;display:flex;flex-direction:column;align-items:center;gap:4px;\n  padding:0 11px;min-width:58px;text-decoration:none;\n  animation:sd-rise var(--sd-rise-dur) var(--sd-rise-ease) both;animation-delay:calc(var(--i,0) * var(--sd-rise-step))}\n.sd-node .sd-planet{--_d:13px;margin-bottom:1px}\n.sd-node.sd-now .sd-planet{--_d:9px}\n.sd-node b{font-family:var(--mono,var(--num,ui-monospace,monospace));font-size:11px;color:#cdd6e4;font-variant-numeric:tabular-nums}\n.sd-node .sd-t{font-size:9.5px;line-height:1.35;color:#9aa5b8;max-width:70px;text-align:center}\n.sd-node i{font-style:normal;font-family:var(--mono,var(--num,monospace));font-size:9px;color:#6b7385;letter-spacing:.04em}\n.sd-node.sd-now b{color:var(--sd-ember);letter-spacing:.14em}\n.sd-node.hot b,.sd-node.hot i{color:var(--sd-ember)}\n.sd-node.hot .sd-t{color:#e8edf2}\n.sd-node:hover .sd-t{color:#e8edf2}\n@media(max-width:760px){.sd-buoy-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media(max-width:400px){.sd-buoy-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(prefers-reduced-motion:reduce){.sd-planet,.sd-gauge,.sd-node{animation:none!important}}\n@media print{.sd-planet,.sd-gauge,.sd-node{animation:none!important}}\n</style>\n<div class=\"con-posture\"><div class=\"con-tagcell\">TODAY<span>今日盤勢</span></div><div class=\"con-body\"><div style=\"display:flex;align-items:center;gap:7px 12px;flex-wrap:wrap;margin-bottom:9px\"><span style=\"font-size:11px;color:#6b7385\">2026-08-23 週日 · 盤前 · 08-21 版判讀 · 今日更新中</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;border:1px solid #3a4150;color:#cdd6e4\">區間整理</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;background:#f871711f;border:1px solid #f8717166;color:#f87171;font-weight:700\">氣壓 -2/6 偏逆風</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.4);color:#f87171;font-weight:700\">● 事件風險 啟動中</span></div><div style=\"font-size:15px;line-height:1.62;color:#eef2f7;font-weight:500\">荷莫茲僵局連日佔頭條但 Brent 93.74 幾乎平盤，利空鈍化浮現；VIX 跳升至 16.01（+7.5%），市場真正在防的是 8/26 NVIDIA 財報＋PCE＋Jackson Hole 三重壓力測試。</div><div style=\"margin-top:10px;border-top:1px solid #232a36;padding-top:8px\"><div style=\"font-family:ui-monospace,monospace;font-size:9.5px;letter-spacing:.16em;color:#6b7385;margin-bottom:5px\">HISTORY · 過去盤勢（近 20 日判讀 · 可捲動）</div><div style=\"max-height:118px;overflow-y:auto;scrollbar-width:thin;padding-right:6px\"><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/20 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向地緣與能源供給風險；只要油價風險溢價未退場,通膨與利率壓力就不算解除。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/19 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半 -4.98%、台股月結算日重挫 -2.48% 至 44,719，美債拋售（殖利率 4.72%）與荷姆茲升級（Brent 91.71）雙線夾擊不再二選一；8/26 NVIDIA 財報前風險溢價難自行消退。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/18 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">荷姆茲海峽封鎖推 Brent 至 91.34、VIX 單日跳 6.6%，川普同步禁蘋果採購中國記憶體；台股收盤前 -1.1% 至 45,309，明天月結算再添壓力，行情軸心從利率定價轉向地緣供給衝擊。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/17 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向政策、通膨與殖利率；風險資產能否續強,取決於市場是否相信高利率只是短期擾動。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/16 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪公開新聞未出現明確 CRITICAL/HIGH 主軸；事件風險暫無升級,但仍需等下一輪新聞與市場 tape 驗證。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/15 週六</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪公開新聞未出現明確 CRITICAL/HIGH 主軸；事件風險暫無升級,但仍需等下一輪新聞與市場 tape 驗證。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/14 週五</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">CPI 紅利第二天，S&amp;P 500 收 7,799 距歷史高僅 17 點，台股收 45,811 漲 0.64%——但台積電逆勢跌 1.64% 至 2,395，資金明確往生技、原材料輪動，期貨淨空 8.6 萬口顯示法人仍有戒心。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/13 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">CPI 過關、費半隔夜噴漲 +2.49% 至 12,399，台股跳空漲逾 900 點站上 46,021——台積電 2 奈米量產消息與 MSCI 調整同日點火，但美債 4.70% 逆風未退，明日 Q2 財報截止才是多頭第二道考試。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/12 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半隔夜反彈 +0.87% 收 12,098，台股跟漲至 45,518，但 Brent 89.75 續逼 90 美元——今晚美國 7 月 CPI 公布，油價是否燒進通膨數字，決定反彈能走多遠。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/11 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">荷莫茲海峽重啟談判受阻推隔夜油價飆逾 5%，費半 −2.94% 摜至 11,994；台股靠財報利多硬撐收漲 191 點至 45,121，但明天 CPI 前油價火苗讓通膨敘事重新回桌。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/10 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台積電生態系連發兩箭（Sony 熊本 63 億美元影像感測器廠＋傳購友達廠房），加權指數跳空漲 2.18% 至 45,192；但美債殖利率 4.69% 與期貨空單 −8.8 萬口形成對拉，週三 CPI 前不宜忽略反向力道。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/09 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪公開新聞未出現明確 CRITICAL/HIGH 主軸；事件風險暫無升級,但仍需等下一輪新聞與市場 tape 驗證。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/08 週六</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪公開新聞未出現明確 CRITICAL/HIGH 主軸；事件風險暫無升級,但仍需等下一輪新聞與市場 tape 驗證。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/07 週五</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半止穩 12,049（+0.33%）、荷莫茲封航疑慮卻把 Brent 推回 83.59（+1.33%），昨天說「等非農」，今晚就是攤牌——7 月就業數據將決定降息敘事加速還是熄火。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/06 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半隔夜回吐 -1.4% 至 12,009，台積電跟退至 2,365（-1.66%），昨天的半導體齊漲只撐一天；荷莫茲解封壓油價破 80 是順風，但明天非農才是方向盤，市場選擇原地等。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/05 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半隔夜暴衝 +6.55%，台積電今日反彈 +3.66% 至 2,405、大盤跳空至 44,612（+2.88%），昨天的「棄權值追記憶體」一日即翻頁——半導體全族群同漲，但非農後天到、美債 4.70% 仍頂頭。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/04 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">Nasdaq 隔夜飆 +2.13%，台積電卻逆勢重挫 -2.11% 至 2,320，大盤 43,361 僅微跌 -0.06%——資金不是撤退，是從權值龍頭轉進旺宏（盤中漲逾 8%）與南電（7 月營收 43 個月新高）；非農倒數三天</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/03 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">週五 +7.98% 軋空後台積電回吐 -1.44% 至 2,390、但大盤逆勢撐住 +1.43% 至 43,737，資金從權值股向金融與航運輪動；荷莫茲與關稅雙雷暫未引爆，8/7 非農前屬消化期。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/02 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台股 +7.98% 軋空行情已兌現，台積電鎖漲停 2,425；但週末浮現荷莫茲海峽 LNG 遇襲（Brent 90.12）與川普數十國新關稅兩顆未爆彈，週一開盤即驗「軋空後能否站穩」。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">08/01 週六</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台股單日暴漲 7.98% 至 43,119、台積電鎖漲停 2,425，但氣壓場仍亮「偏逆風」——空單回補驅動的軋空行情能否站穩，取決於 08/07 非農是否容許利率預期鬆綁。</span></div></div></div></div></div><div class=\"con-panels\"><div style=\"background:#12151c;border:1px solid #2a3140;border-radius:12px;padding:11px 12px\"><div style=\"display:flex;align-items:baseline;gap:6px;margin-bottom:9px\"><span style=\"font-size:12.5px;font-weight:700\">資金浮力場</span><span class=\"con-eb\">BUOYANCY</span><a href=\"/sector_strength_tw.html\" style=\"margin-left:auto;font-size:11px;color:#60a5fa;text-decoration:none\">全版 →</a></div><div style=\"display:flex;gap:6px;flex-wrap:wrap;margin-bottom:5px\"><span class=\"sd-chip\"><span class=\"sd-planet tw-strong\" style=\"--_d:13px\"></span>航運<b style=\"color:#4ade80\">+17</b></span><span class=\"sd-chip\"><span class=\"sd-planet tw-strong\" style=\"--_d:13px\"></span>生技醫療<b style=\"color:#4ade80\">+10</b></span></div><div style=\"border-top:1px dashed #2a3140;margin:6px 0;font-size:9px;color:#46506a;text-align:center;line-height:1\">水位線</div><div style=\"display:flex;gap:6px;flex-wrap:wrap;margin-top:5px\"><span class=\"sd-chip\"><span class=\"sd-planet tw-weak\" style=\"--_d:13px\"></span>油電燃氣<b style=\"color:#f87171\">-18</b></span><span class=\"sd-chip\"><span class=\"sd-planet tw-weak\" style=\"--_d:13px\"></span>塑膠<b style=\"color:#f87171\">-7</b></span></div><div style=\"font-size:9.5px;color:#6b7385;margin-top:8px\">綠＝資金流入／紅＝流出 · 球高即浮力 · 更新 8/22 06:30</div></div><div style=\"background:#12151c;border:1px solid #2a3140;border-radius:12px;padding:11px 12px\"><div style=\"display:flex;align-items:baseline;gap:6px;margin-bottom:9px\"><span style=\"font-size:12.5px;font-weight:700\">總經氣壓場</span><span class=\"con-eb\">PRESSURE</span><span style=\"font-size:11px;font-weight:800;color:#f87171\">偏逆風</span><a href=\"/macro.html\" style=\"margin-left:auto;font-size:11px;color:#60a5fa;text-decoration:none\">全版 →</a></div><div style=\"position:relative;height:8px;border-radius:100px;background:linear-gradient(90deg,#f87171,#3a4150 50%,#4ade80);opacity:.5;margin:10px 0 3px\"></div><div style=\"position:relative;height:0;margin-bottom:13px\"><span style=\"position:absolute;left:33%;top:-16px;width:2px;height:14px;background:#fff;border-radius:2px\"></span><span style=\"position:absolute;left:0;top:-2px;font-size:9px;color:#6b7385\">逆風</span><span style=\"position:absolute;right:0;top:-2px;font-size:9px;color:#6b7385\">順風</span></div><div style=\"display:flex;gap:4px 9px;flex-wrap:wrap;font-size:10.5px;color:#cdd6e4\"><a href=\"/instrument_usd.html\" style=\"white-space:nowrap;color:inherit;text-decoration:none;border-bottom:1px dotted #3a4150\">美元<span style=\"color:#9aa5b8\">→</span></a><span style=\"white-space:nowrap\">美債<span style=\"color:#f87171\">↓</span></span><span style=\"white-space:nowra