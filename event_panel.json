r,var(--border,#232a36));border:1px solid var(--hair,var(--border,#232a36));\n  border-radius:3px;overflow:hidden}\n.sd-gauge{position:relative;display:flex;flex-direction:column;align-items:center;gap:9px;\n  padding:17px 12px 15px;background:var(--ink,var(--bg-card,#0e1015));\n  animation:sd-rise var(--sd-rise-dur) var(--sd-rise-ease) both;animation-delay:calc(var(--i,0) * var(--sd-rise-step))}\n.sd-gauge .sd-planet{--_d:30px}\n.sd-g-v{font-family:var(--num,ui-monospace,Menlo,monospace);font-size:18px;font-weight:600;\n  color:#eef2f7;line-height:1;font-variant-numeric:tabular-nums}\n.sd-g-v small{font-size:11px;color:var(--text-3,#6b7385);font-weight:400;margin-left:1px}\n.sd-g-k{font-size:10px;letter-spacing:.08em;color:var(--text-3,#6b7385);display:flex;align-items:center;gap:5px;\n  white-space:nowrap;text-align:center}\n.sd-mkt{font-family:var(--num,ui-monospace,monospace);font-size:8.5px;letter-spacing:.06em;padding:1px 4px;border-radius:2px;font-weight:700}\n.sd-mkt.tw{color:var(--sd-tw-strong);background:rgba(74,222,128,.1)}\n.sd-mkt.us{color:var(--sd-us-strong);background:rgba(74,222,128,.1)}\n/* 浮力晶片（BUOYANCY 面板：行星 + 名稱 + 值）*/\n.sd-chip{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#cdd6e4;\n  background:#10131a;border:1px solid var(--border,#232a36);border-radius:6px;padding:3px 8px 3px 6px}\n.sd-chip .sd-planet{--_d:13px}\n.sd-chip b{font-weight:600;font-variant-numeric:tabular-nums}\n/* 軌道/地平線（HORIZON 前方事件：NOW → 前方航點行星，可橫捲）*/\n.sd-orbit{position:relative;display:flex;align-items:flex-start;gap:0;overflow-x:auto;scrollbar-width:none;\n  padding:16px 2px 4px;margin-top:2px}\n.sd-orbit::-webkit-scrollbar{display:none}\n.sd-orbit::before{content:\"\";position:absolute;left:6px;right:6px;top:23px;height:1px;\n  background:linear-gradient(90deg,var(--sd-ember),rgba(255,138,61,.15) 62%,transparent)}\n.sd-node{flex:0 0 auto;position:relative;display:flex;flex-direction:column;align-items:center;gap:4px;\n  padding:0 11px;min-width:58px;text-decoration:none;\n  animation:sd-rise var(--sd-rise-dur) var(--sd-rise-ease) both;animation-delay:calc(var(--i,0) * var(--sd-rise-step))}\n.sd-node .sd-planet{--_d:13px;margin-bottom:1px}\n.sd-node.sd-now .sd-planet{--_d:9px}\n.sd-node b{font-family:var(--mono,var(--num,ui-monospace,monospace));font-size:11px;color:#cdd6e4;font-variant-numeric:tabular-nums}\n.sd-node .sd-t{font-size:9.5px;line-height:1.35;color:#9aa5b8;max-width:70px;text-align:center}\n.sd-node i{font-style:normal;font-family:var(--mono,var(--num,monospace));font-size:9px;color:#6b7385;letter-spacing:.04em}\n.sd-node.sd-now b{color:var(--sd-ember);letter-spacing:.14em}\n.sd-node.hot b,.sd-node.hot i{color:var(--sd-ember)}\n.sd-node.hot .sd-t{color:#e8edf2}\n.sd-node:hover .sd-t{color:#e8edf2}\n@media(max-width:760px){.sd-buoy-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media(max-width:400px){.sd-buoy-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(prefers-reduced-motion:reduce){.sd-planet,.sd-gauge,.sd-node{animation:none!important}}\n@media print{.sd-planet,.sd-gauge,.sd-node{animation:none!important}}\n</style>\n<div class=\"con-posture\"><div class=\"con-tagcell\">TODAY<span>今日盤勢</span></div><div class=\"con-body\"><div style=\"display:flex;align-items:center;gap:7px 12px;flex-wrap:wrap;margin-bottom:9px\"><span style=\"font-size:11px;color:#6b7385\">2026-09-27 週日 · 週末整理 · 09-26 版判讀 · 今日更新中</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;border:1px solid #3a4150;color:#cdd6e4\">區間整理</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;background:#9aa5b81f;border:1px solid #9aa5b866;color:#9aa5b8;font-weight:700\">氣壓 +0/6 中性</span><span style=\"font-size:11px;padding:2px 9px;border-radius:100px;background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.4);color:#f87171;font-weight:700\">● 事件風險 啟動中</span></div><div style=\"font-size:15px;line-height:1.62;color:#eef2f7;font-weight:500\">昨日胡賽攻擊引爆的油價高台今天急退，Brent 收 97.47（前收 100.22，−2.74%），宏觀氣壓場得分從四力逆風（−4）回到中性（0）。費半同步彈升 1.41% 至 12,669，VIX 跌穿 15 收 14.87，風險偏好顯著解凍；但美債殖利率仍釘在 5.18%、台指夜盤收 47,956（−169 點，vs 前結算 48,125）</div><div style=\"margin-top:10px;border-top:1px solid #232a36;padding-top:8px\"><div style=\"font-family:ui-monospace,monospace;font-size:9.5px;letter-spacing:.16em;color:#6b7385;margin-bottom:5px\">HISTORY · 過去盤勢（近 20 日判讀 · 可捲動）</div><div style=\"max-height:118px;overflow-y:auto;scrollbar-width:thin;padding-right:6px\"><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/25 週五</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">胡賽武裝攻擊沙烏地阿拉伯，油價前夜跳漲約 3%，推動三十年期美債殖利率觸二十年高點；Brent 現報 105.38（前收 106.60），雖略自高點回落，長端利率壓力仍壓頂，氣壓場擴至四力逆風（得分 −4）。台股 09/24 日盤收 48,024.60（−132.69 點，−0.28%）</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/24 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">聯準會鷹派加碼將十月升息機率推至近七成，費半 −1.23% 領跌拖累台指夜盤收 47,909（−403 點），氣壓場三力逆風（美元、美債、籌碼）確認短線利率壓力壓過 AI 需求敘事。9/30 PCE 將決定十月升息是否落地。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/23 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪新聞聚焦 AI / 半導體,但當日 tape 上費半 -1.79%明顯走弱;敘事與量價背離時先以量價為錨,別把利多標題放大成趨勢確立。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/22 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半週一飆漲 4.29%、TSM ADR +2.41%，但荷莫茲海峽油輪遇襲將 Brent 推至 97.66 美元，台股日盤僅收漲 0.17%、台積電反跌 0.81%。夜盤 +728 點的樂觀能否兌現，取決於油價守不守得住 100 美元整數關。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/21 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向地緣與能源供給風險；只要油價風險溢價未退場,通膨與利率壓力就不算解除。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/20 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半週五漲 2.78%、加權指數大漲 893 點收 47,181，半導體氣勢壓過一切；但荷莫茲海峽漏油與利雅德機場濃煙在所有市場收盤後才傳出，這筆地緣帳尚未入價。週一驗證：Brent 99.3 是否跳空、台指夜盤 47,405 怎麼接。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/19 週六</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">全球市場主軸是「AI 成長敘事撐住股市」對上「中東 / 油價 / 利率重新推高風險溢價」的拉鋸。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/18 週五</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向地緣與能源供給風險；只要油價風險溢價未退場,通膨與利率壓力就不算解除。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/17 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">全球市場主軸是「AI 成長敘事撐住股市」對上「中東 / 油價 / 利率重新推高風險溢價」的拉鋸。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/16 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">今天的核心分歧：美債 10 年期觸近 4.97%（研究庫標記逆風），FOMC 今晚決議，美股普跌；但費半（SOX +0.40%）與台股加權（+0.68%，盤中 45,820）同步逆勢，聯發科首款 2 奈米手機晶片是本地催化錨點。台指夜盤（9/16 歸屬日，官方收 45,529；基準前收 45,592）夜間整理幅度溫和，日盤快速收復缺口；分叉能否延伸</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/15 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向地緣與能源供給風險；只要油價風險溢價未退場,通膨與利率壓力就不算解除。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/14 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">AI 成長敘事仍在,但當日 tape 上費半 -5.09%明顯走弱、半導體並非最強;再疊加中東 / 油價 / 利率風險溢價,敘事與量價背離時先以量價為錨。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/13 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台股周五急跌 756 點（-1.61%）收 46,185，夜盤期指隨後反彈 401 點。台積電 ADR 同夜漲 1.22%，日盤與夜盤出現清晰分叉。周末沙烏地油管限流加上美軍縮減霍爾木茲護航窗口，兩則地緣訊號尚未計入油價；FOMC 三天後落槌，是本周最近的方向確認節點。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/12 週六</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪公開新聞未出現明確 CRITICAL/HIGH 主軸；事件風險暫無升級,但仍需等下一輪新聞與市場 tape 驗證。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/11 週五</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">本輪事件主軸偏向政策、通膨與殖利率；風險資產能否續強,取決於市場是否相信高利率只是短期擾動。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/10 週四</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">昨日「拔河」已在今日上半場分出勝負：Brent 守穩 101.24 美元，台股加權（TWII）盤中跌至 46,837（−0.73%），47,000 關口失守。費半（SOX）昨夜逆漲 +0.37%，外資早盤押注 AI 主線近 200 億台幣——但仍未能撐住關口；台積電 8 月營收今日是第一道驗證，明日 CPI 才是決定行情能否再向下一段的裁決點。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/09 週三</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">荷姆茲海峽升級為實彈戰場，Brent 99.45 美元叩關百元。但費半逆漲 +1.3%、台股 47,183 僅微揚——油價恐慌與 AI 資金流正在拔河，明天台積電 8 月營收、週四 CPI 是兩道裁決線。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/08 週二</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">台股加權指數 47,105.78（-0.47%）從昨日高點收斂，Brent 原油 $98.27（+2.07%）衝近 6 週高點、銅價據報創歷史新高——油銅聯漲把通膨疑慮重新帶回台面，美債殖利率已在 4.77% 的逆風位置。ASML 贏得 TSMC／Samsung EUV 新機台訂單、蘋果改簽 NAND 長約，半導體鏈另有催化劑在撐</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/07 週一</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">SOX 上週五衝 3.38%，今天接棒效應推著台股大盤開高至 47,338（+787 點）。但市場內部正在分家：聯電靠 8 月營收漲停，鴻海靠 AI 故事已波段跌 27%。9/10 台積電營收與 9/11 美國 CPI 是本週兩根驗證棒，哪根先折，今天的漲勢就從哪裡測試。</span></div><div style=\"display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px dashed #232a36\"><span style=\"flex:none;font-family:ui-monospace,monospace;font-size:10.5px;color:#6b7385\">09/06 週日</span><span style=\"font-size:11.5px;line-height:1.55;color:#9aa5b8\">費半 +3.4% 至 11,735 驗收 AI 需求無虞，但荷莫茲海峽衝突把 Brent 推上 96.3、美債殖利率卡 4.77%，S&amp;P 反跌 0.4% 不買單——9/11 CPI 若被油價灌髒，分歧收斂方向就不妙。</span></div></div></div></div></div><div class=\"con-panels\"><div style=\"background:#12151c;border:1px solid #2a3140;border-radius:12px;padding:11px 12px\"><div style=\"display:flex;align-items:baseline;gap:6px;margin-bottom:9px\"><span style=\"font-size:12.5px;font-weight:700\">資金浮力場</span><span class=\"con-eb\">BUOYANCY</span><a href=\"/sector_strength_tw.html\" style=\"margin-left:auto;font-size:11px;color:#60a5fa;text-decoration:none\">全版 →</a></div><div style=\"display:flex;gap:6px;flex-wrap:wrap;margin-bottom:5px\"><span class=\"sd-chip\"><span class=\"sd-planet tw-strong\" style=\"--_d:13px\"></span>油電燃氣<b style=\"color:#4ade80\">+16</b></span><span class=\"sd-chip\"><span class=\"sd-planet tw-strong\" style=\"--_d:13px\"></span>塑膠<b style=\"color:#4ade80\">+8</b></span></div><div style=\"border-top:1px dashed #2a3140;margin:6px 0;font-size:9px;color:#46506a;text-align:center;line-height:1\">水位線</div><div style=\"display:flex;gap:6px;flex-wrap:wrap;margin-top:5px\"><span class=\"sd-chip\"><span class=\"sd-planet tw-weak\" style=\"--_d:13px\"></span>生技醫療<b style=\"color:#f87171\">-22</b></span><span class=\"sd-chip\"><span class=\"sd-planet tw-weak\" style=\"--_d:13px\"></span>化學生技醫療<b style=\"color:#f87171\">-17</b></span></div><div style=\"font-size:9.5px;color:#6b7385;margin-top:8px\">綠＝資金流入／紅＝流出 · 球高即浮力 · 更新 9/26 06:31</div></div><div style=\"background:#12151c;border:1px solid #2a3140;border-radius:12px;padding:11px 12px\"><div style=\"display:flex;align-items:baseline;gap:6px;margin-bottom:9px\"><span style=\"font-size:12.5px;font-weight:700\">總經氣壓場</span><span class=\"con-eb\">PRESSURE</span><span style=\"font-size:11px;font-weight:800;color:#9aa5b8\">中性</span><a href=\"/macro.html\" style=\"margin-left:auto;font-size:11px;color:#60a5fa;text-decoration:none\">全版 →</a></div